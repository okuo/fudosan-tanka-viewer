{
  "manifest_version": 3,
  "name": "不動産坪単価・平米単価表示",
  "version": "1.6.0",
  "description": "SUUMO、三井のリハウス、アットホーム、ホームズで坪単価・平米単価・月々概算・価格改定を自動表示します",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.suumo.jp/*",
    "*://*.rehouse.co.jp/*",
    "*://*.athome.co.jp/*",
    "*://*.homes.co.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.suumo.jp/*",
        "*://*.rehouse.co.jp/*",
        "*://*.athome.co.jp/*",
        "*://*.homes.co.jp/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
